<robot name="amr">

    <material>
        <name>blue</name>
        <color rgba="0 0 1 1"/>
    </material>

    <link name="base_link">
        <visual>
            <geometry>
                <box size="0.5 0.3 0.1"/>
            </geometry>
            <material name="blue">
                <color rgba="0 0 1 1"/>
            </material>
        </visual></link>

    <link name="wheel_front_left">
        <visual>
            <geometry>
                <cylinder radius="0.1" length="0.04"/>
            </geometry>
            <material name="blue" />
        </visual>            
        </link>
    <joint name="joint_front_left" type="continuous">
        <parent link="base_link"/>
        <child link="wheel_front_left"/>
        <origin xyz="0.2 0.15 0" rpy="1.52 0 0"/>
        <axis xyz="0 0 -1"/></joint> 

    <link name="wheel_front_right">
        <visual>
            <geometry>
                <cylinder radius="0.1" length="0.04"/>
            </geometry>
            <material name="blue"/>
        </visual>            
        </link>
    <joint name="joint_front_right" type="continuous">
        <parent link="base_link"/>
        <child link="wheel_front_right"/>
        <origin xyz="0.2 -0.15 0" rpy="1.52 0 0"/>
        <axis xyz="0 0 -1"/></joint>

    <link name="wheel_back_left">
        <visual>
            <geometry>
                <cylinder radius="0.1" length="0.04"/>
            </geometry>
            <material name="blue" />
        </visual>            
        </link>
    <joint name="joint_back_left" type="continuous">
        <parent link="base_link"/>
        <child link="wheel_back_left"/>
        <origin xyz="-0.2 0.15 0" rpy="1.52 0 0"/>
        <axis xyz="0 0 -1"/></joint> 

    <link name="wheel_back_right">
        <visual>
            <geometry>
                <cylinder radius="0.1" length="0.04"/>
            </geometry>
            <material name="blue"/>
        </visual>            
        </link>
    <joint name="joint_back_right" type="continuous">
        <parent link="base_link"/>
        <child link="wheel_back_right"/>
        <origin xyz="-0.2 -0.15 0" rpy="1.52 0 0"/>
        <axis xyz="0 0 -1"/></joint>

</robot>